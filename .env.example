APP_NAME=Judge
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost
APP_TIMEZONE=Asia/Seoul

# 기본 언어는 한국어입니다. 영어로 운영하려면 아래 두 값을 en으로 변경하세요.
APP_LOCALE=ko
APP_FALLBACK_LOCALE=ko

DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=db_judge
DB_USERNAME=judge
DB_PASSWORD="change-this-to-a-long-random-password-2026!"

# 전체 관리자 (/root). 비우면 기능이 꺼집니다(404).
# 해시 권장: php artisan tinker --execute="echo Hash::make('비밀번호');"
JUDGE_SUPER_ADMIN_PASSWORD=

# ── 캐시·세션 저장소 ─────────────────────────────────────────────────────
# redis 로 두면 세션도 함께 Redis 에 실린다(config/session.php). Redis 가 없으면 database.
CACHE_STORE=redis

# Redis 접속. 비밀번호가 없으면 REDIS_PASSWORD 줄은 지워도 된다.
# REDIS_PREFIX 는 모든 키 앞에 붙어 같은 Redis 를 쓰는 다른 사이트와 섞이지 않게 한다.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_PREFIX="judge:"
